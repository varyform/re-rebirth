# Settings for `kamal`, read by config/deploy.yml.
# cp .env.deploy.example .env.deploy (gitignored) and fill in.

# The server's IP or hostname (SSH access as root, Docker installed by `kamal setup`).
SITE_SERVER=203.0.113.7

# The public hostname, with an A record pointing at the server; it gets a
# Let's Encrypt certificate.
SITE_HOST=rb.example.com
